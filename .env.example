# Matrix homeserver (e.g. https://matrix.org or your self-hosted URL)
MATRIX_HOMESERVER=https://matrix.org

# Bot account credentials. Use either password OR access token, not both.
MATRIX_USER_ID=@yourbot:matrix.org
MATRIX_PASSWORD=changeme
# MATRIX_ACCESS_TOKEN=

# Comma-separated list of fully-qualified user IDs allowed to talk to the bot.
# Leave empty to allow anyone (NOT recommended for public homeservers).
MATRIX_ALLOWED_USERS=@you:matrix.org

# Directory the bot operates in (cwd for the agent).
BOT_CWD=/home/agu/gitpool/tradebots

# Optional: persist sessions per-room under this directory.
# SESSION_DIR=./sessions

# Optional: where to store the bot's access token, device id, and recovery key.
# Default: ./data (relative to the project root). Created with 0600 perms.
BOT_DATA_DIR=./data

# Optional: log level (debug|info|warn|error). Default: info.
LOG_LEVEL=info

# Optional: recovery key for the bot account's secret storage. Required if
# secret storage was set up on a previous device. Once provided, it will
# be cached in $BOT_DATA_DIR/bot-state.json (chmod 0600).
# MATRIX_RECOVERY_KEY=
