node_modules/
data/
sessions/
*.log

# The parent .gitignore excludes .env repo-wide, but this .env is a committed
# template holding no secrets — real values live in .env.local.
!.env
.env.local
.env.*.local
v1-archive/
outbox/
inbox/
workspace/

# Editor swap/backup files. A swap of .env.local would contain the Matrix
# password and recovery key, and none of these are covered by the .env rules.
*.swp
*.swo
*~
.*.sw?
