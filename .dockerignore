# The image installs its own; a host node_modules carries the host's native
# binding and would shadow the one built for the image.
node_modules

# State, never baked into an image. data/ in particular is the bot's Matrix
# identity — an image carrying it would clone the device wherever it ran.
data
sessions
inbox
outbox

# Real credentials live here. .env is the committed template and is harmless.
.env.local
.env.*.local

.git
.gitignore
Dockerfile
.dockerignore
docs
*.md
!README.md

# Provisioning and development, not runtime. Neither can work in the image
# anyway: cross-signing needs matrix-js-sdk, which `npm ci --omit=dev` leaves
# out, and cross-sign-container.sh expects a deployment directory with its own
# .env — which a container does not have, its environment coming from
# env_file at run time. A script that is present but cannot work is worse than
# one that is absent, because someone will try it.
scripts
test
prompts
