# Committed template — keys, documentation, and generic defaults only.
#
# Put real values in .env.local, which is gitignored. dotenv-flow loads this
# file first and lets .env.local override every key; real environment variables
# win over both.
#
#   cp .env .env.local     # then fill it in

# --- Matrix account -----------------------------------------------------------

# Homeserver base URL, e.g. https://matrix.example.org
MATRIX_HOMESERVER=

# Full MXID of the bot, e.g. @mybot:example.org
MATRIX_USER_ID=

# Used only for the first login; after that data/token.json is reused.
# Also required by `npm run cross-sign` to satisfy user-interactive auth.
MATRIX_PASSWORD=

# Comma-separated MXIDs allowed to talk to the bot, e.g.
#   @me:example.org,@colleague:example.org
# EMPTY MEANS EVERYONE IS ALLOWED. The agent runs shell commands, so set this.
MATRIX_ALLOWED_USERS=

# Device name shown in Element's session list. Optional.
MATRIX_DEVICE_NAME=

# Only used by `npm run cross-sign`, never by the bot itself. Needed to unlock
# the account's self-signing key from secret storage.
MATRIX_RECOVERY_KEY=

# --- Storage ------------------------------------------------------------------

# Where token.json, sync.json and the crypto store live. Optional.
# Default ./data. This directory IS the bot's identity — back it up accordingly.
DATA_DIR=

# --- Agent --------------------------------------------------------------------

# Working directory the agent operates in (cwd for its Bash, Read, Edit, Write
# tools). Default: process.cwd() at startup.
# Anyone on the allowlist can read and modify anything under this path, so
# scope it to the narrowest useful directory, e.g. /srv/projects/my-repo
BOT_CWD=

# pi model selector. Either "<provider>/<model-id>" or a bare "<model-id>", in
# which case the provider comes from PI_PROVIDER if set in the shell.
# Empty uses the first available model, e.g. anthropic/claude-opus-4-5
PI_MODEL=

# off | minimal | low | medium | high | xhigh | max
PI_THINKING_LEVEL=low

# Persist each room's conversation under this directory so memory survives
# restarts. Leave empty for in-memory sessions that reset on every startup.
SESSION_DIR=./sessions

# --- Outbox -------------------------------------------------------------------

# Spool directory other processes drop messages into for the bot to send.
# Only the bot may open the crypto store: a second client desynchronises the
# Megolm ratchet and produces messages strict clients refuse to decrypt.
# Writers must write a temp file elsewhere and rename() it in, so the bot never
# reads a partial file.
OUTBOX_DIR=./outbox

# Room used for *.txt drops and for *.json without an explicit "room",
# e.g. !abcdef:example.org
OUTBOX_DEFAULT_ROOM=

# --- Logging ------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info
