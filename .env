# Committed template — keys, documentation, and generic defaults only.
#
# Put real values in .env.local, which is gitignored. dotenv-flow loads this
# file first and lets .env.local override every key; real environment variables
# win over both.
#
#   cp .env .env.local     # then fill it in

# --- Matrix account -----------------------------------------------------------

# Homeserver base URL, e.g. https://matrix.example.org
MATRIX_HOMESERVER=

# Full MXID of the bot, e.g. @mybot:example.org
MATRIX_USER_ID=

# Used only for the first login; after that data/token.json is reused.
# Also required by `npm run cross-sign` to satisfy user-interactive auth.
MATRIX_PASSWORD=

# Comma-separated MXIDs allowed to talk to the bot, e.g.
#   @me:example.org,@colleague:example.org
# EMPTY MEANS EVERYONE IS ALLOWED — including other bots, which will answer each
# other unattended. The agent runs shell commands, so set this.
MATRIX_ALLOWED_USERS=

# Device name shown in Element's session list. Optional.
MATRIX_DEVICE_NAME=

# Only used by `npm run cross-sign`, never by the bot itself. Needed to unlock
# the account's self-signing key from secret storage.
MATRIX_RECOVERY_KEY=

# --- Storage ------------------------------------------------------------------

# Where token.json, sync.json and the crypto store live.
# This directory IS the bot's identity — back it up accordingly.
DATA_DIR=./data

# --- Agent --------------------------------------------------------------------

# Working directory the agent operates in (cwd for its Bash, Read, Edit, Write
# tools), created on startup if missing and resolved to an absolute path.
#
# Anyone on the allowlist can read and modify anything under this path, so scope
# it to the narrowest useful directory — point it at the project you want the
# agent working on, e.g. /srv/projects/my-repo.
#
# The default is a scratch directory the bot creates, rather than the repo root
# — the repo root holds the bot's own credentials, and was the old default.
#
# It is a subdirectory of /tmp, not /tmp itself. /tmp is world-writable (mode
# 1777), so working there directly would expose the agent's output to every user
# on the box and let others plant files it reads. A subdirectory the bot creates
# gets the bot user's own permissions instead.
#
# Note it is temporary: most systems clear /tmp on reboot, and some mount it
# noexec, which would break a script the agent writes and then tries to run.
# Point this at a durable path once you know what you want the agent working on.
#
# There is no fallback in config/default.js — the bot refuses to start if this
# is unset, so a missing .env fails loudly instead of quietly reverting to the
# directory the bot happened to be started from.
BOT_CWD=/tmp/piagent-workspace

# --- Model provider -----------------------------------------------------------
#
# The agent needs a provider. The simplest way is to put an API key here (in
# .env.local, not this file): pi picks it up from the environment and writes
# data/pi/auth.json on first use. No pi install or login needed.
#
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Also recognised: GEMINI_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY,
# MINIMAX_API_KEY, MINIMAX_CN_API_KEY, CEREBRAS_API_KEY, FIREWORKS_API_KEY,
# GROQ_API_KEY, OPENROUTER_API_KEY, XAI_API_KEY.
#
# For OAuth/subscription providers there is no key to paste — log in instead:
#   PI_CODING_AGENT_DIR=./data/pi npx pi     then  /login <provider>
#
# Note PI_CODING_AGENT_DIR is pi's OWN variable, not PI_AGENT_DIR below. The pi
# CLI ignores PI_AGENT_DIR and writes to its own default (~/.pi/agent for the npm
# package, but a standalone install can differ), which looks like it worked
# and leaves the bot finding no credentials.

# The model and thinking level are not configured here. Say `.model` and
# `.thinking` in the main room; the choice is recorded under DATA_DIR/agent.json
# and survives restarts. Until then: first available model, thinking level low.

# pi's own config directory: auth.json, models-store.json, settings.json.
# The bot carries its own provider credentials instead of sharing ~/.pi/agent
# with whoever is running it. See the model provider section above for how to
# populate it — an API key is usually all it takes.
#
# Deliberately left empty: it defaults to ${DATA_DIR}/pi and follows DATA_DIR.
# Setting it pins the path, so moving DATA_DIR would leave pi's credentials
# behind. Only set this to put pi's config somewhere else on purpose.
PI_AGENT_DIR=

# Persist each room's conversation under this directory so memory survives
# restarts. Leave empty for in-memory sessions that reset on every startup.
SESSION_DIR=./sessions

# --- Outbox -------------------------------------------------------------------

# Spool directory other processes drop messages into for the bot to send.
# Only the bot may open the crypto store: a second client desynchronises the
# Megolm ratchet and produces messages strict clients refuse to decrypt.
# Writers must write a temp file elsewhere and rename() it in, so the bot never
# reads a partial file.
OUTBOX_DIR=./outbox

# Unaddressed *.txt drops go to the bot's main room, which the bot adopts and
# records in data/main-room.json. Nothing to set here.

# --- Logging ------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info
