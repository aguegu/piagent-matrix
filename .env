# Committed template. Real values go in .env.local (gitignored), which
# dotenv-flow loads after this file and lets override every key here.

# Homeserver base URL, e.g. https://matrix.example.org
MATRIX_HOMESERVER=

# Full MXID of the bot, e.g. @mybot:example.org
MATRIX_USER_ID=

# Used only for the first login; after that data/token.json is reused.
MATRIX_PASSWORD=

# Comma-separated MXIDs allowed to talk to the bot.
# Empty means everyone is allowed, and the bot warns on every message.
MATRIX_ALLOWED_USERS=

# Device name shown in Element's session list. Optional.
MATRIX_DEVICE_NAME=

# Where token.json, sync.json and the crypto store live. Optional.
DATA_DIR=

# debug | info | warn | error. Optional.
LOG_LEVEL=info

# Only used by `npm run cross-sign`, never by the bot itself.
# Needed to unlock the account's self-signing key from secret storage.
MATRIX_RECOVERY_KEY=

# Working directory the agent operates in (cwd for tools like Bash, Read).
# Default: process.cwd() at startup.
BOT_CWD=/home/agu/gitpool/tradebots

# Optional: pi model selector. Either "<provider>/<model-id>" or just
# "<model-id>" (in which case the provider is taken from PI_PROVIDER if
# set in the shell). Leave empty to use the first available model.
PI_MODEL=minimax-cn/MiniMax-M3

# Optional: pi thinking level.
# off | minimal | low | medium | high | xhigh | max. Default low.
PI_THINKING_LEVEL=low

# Optional: persist sessions per-room under this directory. Uncomment to
# keep conversation memory across bot restarts. Without this, each room
# starts a fresh in-memory session on every startup.
# SESSION_DIR=./sessions
